<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0"><diagram id="4 diagram" name="4 - Davet ve Giriş Akışı"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4 2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Davet ve Giriş Akışı&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#ffe3e3&quot;&gt;Yalnızca davetle giriş: izin listesi + e-posta doğrulaması olmadan veri görünmez&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#d71920;strokeColor=none;fontColor=#ffffff;align=left;spacingLeft=20;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry"/></mxCell><mxCell id="4 3" value="&lt;b&gt;1. PM veya Admin&lt;/b&gt;&lt;br&gt;Members → e-posta + proje rolü yazar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e8f1ff;strokeColor=#2f6fed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="260" height="90" as="geometry"/></mxCell><mxCell id="4 4" value="&lt;b&gt;2. Firestore&#x27;a yazılır&lt;/b&gt;&lt;br&gt;allowlist/{email} + invites/{proje_email}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#fff6e0;strokeColor=#d97706;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="400" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="4 5" value="&lt;b&gt;3. Davetli kişi&lt;/b&gt;&lt;br&gt;Aynı e-postayla hesap oluşturur" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e7f7ee;strokeColor=#16a34a;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="840" y="150" width="280" height="90" as="geometry"/></mxCell><mxCell id="4 6" value="&lt;b&gt;4. Doğrulama e-postası&lt;/b&gt;&lt;br&gt;Bağlantıyı açar (email_verified)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e7f7ee;strokeColor=#16a34a;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="1200" y="150" width="300" height="90" as="geometry"/></mxCell><mxCell id="4 7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 3" target="4 4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 8" value="bilgilendirme (elle)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 4" target="4 5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 5" target="4 6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 10" value="&lt;b&gt;Admin / Executive mi?&lt;/b&gt;&lt;br&gt;Değilse izin listesinde ve e-postası doğrulanmış mı?" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;shape=rhombus;fillColor=#fff6e0;strokeColor=#d97706;strokeWidth=1.5;rounded=0;" vertex="1" parent="1"><mxGeometry x="740" y="330" width="360" height="130" as="geometry"/></mxCell><mxCell id="4 11" value="giriş yapar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 6" target="4 10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1350" y="395"/></Array></mxGeometry></mxCell><mxCell id="4 12" value="&lt;b&gt;Giriş kapısında kalır&lt;/b&gt;&lt;br&gt;Listede yok: &quot;davet edilmediniz&quot;&lt;br&gt;Doğrulanmamış: &quot;e-postanı doğrula&quot;&lt;br&gt;Hiçbir proje görünmez" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#fdecec;strokeColor=#d71920;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="4 13" value="hayır" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 10" target="4 12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 14" value="&lt;b&gt;users/{uid} oluşturulur&lt;/b&gt;&lt;br&gt;role = member (her zaman)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#fff6e0;strokeColor=#d97706;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="740" y="520" width="360" height="90" as="geometry"/></mxCell><mxCell id="4 15" value="evet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 10" target="4 14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 16" value="&lt;b&gt;claimInvites()&lt;/b&gt;&lt;br&gt;invites eşleşir → projects.members&#x27;a eklenir" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e8f1ff;strokeColor=#2f6fed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="740" y="670" width="360" height="90" as="geometry"/></mxCell><mxCell id="4 17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 14" target="4 16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 18" value="&lt;b&gt;Proje listede görünür&lt;/b&gt;&lt;br&gt;Rol: davette yazan proje rolü" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e7f7ee;strokeColor=#16a34a;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="740" y="830" width="360" height="90" as="geometry"/></mxCell><mxCell id="4 19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 16" target="4 18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 20" value="&lt;b&gt;İlk admin&lt;/b&gt;&lt;br&gt;Kimse kendini admin yapamaz.&lt;br&gt;Önce izin listesine eklenip giriş yapılır, sonra konsolda users/{uid}.role = admin elle yazılır" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#fdecec;strokeColor=#d71920;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="1260" y="495" width="300" height="140" as="geometry"/></mxCell><mxCell id="4 21" value="yalnızca ilk&lt;br&gt;admin için" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;strokeColor=#d71920;" edge="1" parent="1" source="4 14" target="4 20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 22" value="&lt;b&gt;Sonraki rol değişiklikleri&lt;/b&gt;&lt;br&gt;Admin: Members &amp;amp; Roles → Users&lt;br&gt;Save ile uygulanır, Audit log&#x27;a yazılır" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#f1ecff;strokeColor=#7c3aed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="520" width="340" height="140" as="geometry"/></mxCell><mxCell id="4 23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.
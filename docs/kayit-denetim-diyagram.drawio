adow=0;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="300" height="110" as="geometry"/></mxCell><mxCell id="5 25" value="eşitleme" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;strokeColor=#16a34a;exitX=0.2;exitY=0;exitDx=0;exitDy=0;" edge="1" parent="1" source="5 16" target="5 24"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1052" y="600"/><mxPoint x="210" y="600"/></Array></mxGeometry></mxCell><mxCell id="5 26" value="Audit log&#x27;a düşen olaylar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#7c3aed;dashed=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#7c3aed;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="840" height="250" as="geometry"/></mxCell><mxCell id="5 27" value="&lt;b&gt;Yönetim&lt;/b&gt;&lt;br&gt;Şirket rolü değişimi&lt;br&gt;Rol yetkileri kaydı&lt;br&gt;İzin listesi ekle / çıkar" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#f1ecff;strokeColor=#7c3aed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="260" height="170" as="geometry"/></mxCell><mxCell id="5 28" value="&lt;b&gt;Üyelik ve proje&lt;/b&gt;&lt;br&gt;Davet gönder / iptal / kabul&lt;br&gt;Proje rolü, üyeyi çıkarma&lt;br&gt;Bulutta proje oluştur / sil" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#f1ecff;strokeColor=#7c3aed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="340" y="380" width="260" height="170" as="geometry"/></mxCell><mxCell id="5 29" value="&lt;b&gt;İçerik&lt;/b&gt;&lt;br&gt;Epic / story / görev ekle, sil&lt;br&gt;Durum, kişi, öncelik, tarih&lt;br&gt;Taşıma, renk, proje adı, arşiv" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#f1ecff;strokeColor=#7c3aed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="620" y="380" width="240" height="170" as="geometry"/></mxCell><mxCell id="5 30" value="&lt;span style=&quot;color:#666666&quot;&gt;&lt;b&gt;Sınır:&lt;/b&gt; Kayıt tarayıcıdan yazılır: kimse başkası adına kayıt atamaz, kaydı değiştiremez veya silemez, ama işlem kayıt atılmadan da yapılabilir (kuralla zorlanmaz). Tam güvence için Cloud Functions gerekir.&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=none;strokeColor=none;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="60" y="950" width="880" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0"><diagram id="3 diagram" name="3 - Roller ve Yetkiler"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3 2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Roller ve Yetkiler&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#ffe3e3&quot;&gt;Şirket rolü kimin neyi gördüğünü, proje rolü ise projede ne yapabileceğini belirler&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#d71920;strokeColor=none;fontColor=#ffffff;align=left;spacingLeft=20;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry"/></mxCell><mxCell id="3 3" value="Organization rolleri (şirket geneli)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e8f1ff;strokeColor=#2f6fed;dashed=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#2f6fed;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="480" height="460" as="geometry"/></mxCell><mxCell id="3 4" value="&lt;b&gt;Admin&lt;/b&gt;&lt;br&gt;Tüm projeleri görür ve tam yetkilidir (proje rolü yok sayılır)&lt;br&gt;Kullanıcı rolleri, yetkiler, izin listesi, Audit log" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2f6fed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="440" height="120" as="geometry"/></mxCell><mxCell id="3 5" value="&lt;b&gt;Executive&lt;/b&gt;&lt;br&gt;Tüm projeleri görür; projede rolü yoksa salt okunur&lt;br&gt;Projede rol verilirse o rolün yetkisini alır" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2f6fed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="305" width="440" height="120" as="geometry"/></mxCell><mxCell id="3 6" value="&lt;b&gt;Member&lt;/b&gt; (varsayılan)&lt;br&gt;Yalnızca eklendiği projeleri görür&lt;br&gt;Yetkisi projedeki rolünden gelir" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2f6fed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="440" height="120" as="geometry"/></mxCell><mxCell id="3 7" value="Project rolleri (proje bazlı)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e7f7ee;strokeColor=#16a34a;dashed=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#16a34a;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="560" y="120" width="1000" height="460" as="geometry"/></mxCell><mxCell id="3 8" value="&lt;table cellpadding=&quot;9&quot; cellspacing=&quot;0&quot; border=&quot;1&quot; style=&quot;border-collapse:collapse;width:940px;font-size:13px;border-color:#9ca3af&quot;&gt;&lt;tr style=&quot;background:#16a34a;color:#fff&quot;&gt;&lt;th align=&quot;left&quot;&gt;Yetki&lt;/th&gt;&lt;th&gt;Project Manager&lt;/th&gt;&lt;th&gt;Team Lead&lt;/th&gt;&lt;th&gt;Contributor&lt;/th&gt;&lt;th&gt;Viewer&lt;/th&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#ffffff&quot;&gt;&lt;td&gt;Projeyi görmek&lt;/td&gt;&lt;td align=&quot;center&quot; style=&quot;color:#16a34a;font-weight:bold&quot;&gt;✔&lt;/td&gt;&lt;td align=&quot;center&quot; style=&quot;color:#16a34a;font-weight:bold&quot;&gt;✔&lt;/td&gt;&lt;td align=&quot;center&quot; style=&quot;color:#16a34a;font-weight:bold&quot;&gt;✔&lt;/td&gt;&lt;td align=&quot;center&quot; style=&quot;color:#16a34a;font-weight:bold&quot;&gt;✔&lt;/td&gt;&lt;/tr&gt;&lt;tr style=&quot;background:#f6f7f9&quot;&gt;&lt;td&gt;Görev oluşturmak&lt;/td&gt;&lt;td align=&quot;center&quot; style=&
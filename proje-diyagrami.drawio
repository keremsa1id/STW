;" vertex="1" parent="1"><mxGeometry x="740" y="330" width="360" height="130" as="geometry"/></mxCell><mxCell id="4 11" value="giriş yapar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 6" target="4 10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1290" y="395"/></Array></mxGeometry></mxCell><mxCell id="4 12" value="&lt;b&gt;Giriş kapısında kalır&lt;/b&gt;&lt;br&gt;Listede yok: &quot;davet edilmediniz&quot;&lt;br&gt;Doğrulanmamış: &quot;e-postanı doğrula&quot;&lt;br&gt;Hiçbir proje görünmez" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#fdecec;strokeColor=#d71920;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="300" y="360" width="300" height="80" as="geometry"/></mxCell><mxCell id="4 13" value="hayır" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 10" target="4 12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 14" value="&lt;b&gt;users/{uid} oluşturulur&lt;/b&gt;&lt;br&gt;role = member (her zaman)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#fff6e0;strokeColor=#d97706;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="740" y="520" width="360" height="90" as="geometry"/></mxCell><mxCell id="4 15" value="evet" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.8;strokeColor=#444444;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="4 10" target="4 14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4 16" value="&lt;b&gt;claimInvites()&lt;/b&gt;&lt;br&gt;invites eşleşir → projects.members&#x27;a eklenir" style="rounded=1;whiteSp
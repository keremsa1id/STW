<mxfile host="app.diagrams.net" agent="Claude" version="24.7.0"><diagram id="1 diagram" name="1 - Sistem Mimarisi"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1 2" value="&lt;b style=&quot;font-size:22px&quot;&gt;Proje Takip: Sistem Mimarisi&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#ffe3e3&quot;&gt;Tek dosyalı web uygulaması (index.html) + Firebase (Auth, Firestore) + GitHub Pages&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#d71920;strokeColor=none;fontColor=#ffffff;align=left;spacingLeft=20;arcSize=12;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1540" height="70" as="geometry"/></mxCell><mxCell id="1 3" value="Kullanıcı cihazı: Tarayıcı / PWA" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#fdecec;strokeColor=#d71920;dashed=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#d71920;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="760" height="860" as="geometry"/></mxCell><mxCell id="1 4" value="&lt;b&gt;index.html&lt;/b&gt; (HTML + CSS + JavaScript; kurulum ve derleme yok)&lt;br&gt;Durum nesnesi &lt;i&gt;db&lt;/i&gt;, değişince &lt;i&gt;render()&lt;/i&gt; DOM&#x27;u yeniden çizer&lt;br&gt;Veri modeli: Proje → Epic → Story → Görev" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#e8f1ff;strokeColor=#2f6fed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="60" y="175" width="700" height="110" as="geometry"/></mxCell><mxCell id="1 5" value="Görünümler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2f6fed;dashed=0;verticalAlign=t
, alt görev, bağlantılar, yorum, etkinlik geçmişi, süre" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2f6fed;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="80" y="495" width="670" height="50" as="geometry"/></mxCell><mxCell id="1 13" value="Uygulama mantığı" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;dashed=0;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontStyle=1;fontSize=14;fontColor=#16a34a;strokeWidth=2;arcSize=3;" vertex="1" parent="1"><mxGeometry x="60" y="585" width="700" height="175" as="geometry"/></mxCell><mxCell id="1 14" value="Geri al (Undo, 8 sn)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="80" y="630" width="205" height="45" as="geometry"/></mxCell><mxCell id="1 15" value="Sürükle-bırak (fare + dokunmatik)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="630" width="205" height="45" as="geometry"/></mxCell><mxCell id="1 16" value="Filtre / Kayıtlı filtre / Ctrl+K arama" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="530" y="630" width="205" height="45" as="geometry"/></mxCell><mxCell id="1 17" value="Tema (otomatik, açık, koyu)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fontSize=12;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#16a34a;strokeWidth=1.5;shadow=0;" vertex="1" parent="1"><mxGeometry x="80" y="690" width="205" height="45" as="geometry"/></mxCell><mxCell id="1 18" value="Yetki denetimi (roleIn, guardPerms)" style="rounded=1;whiteSpace=wrap
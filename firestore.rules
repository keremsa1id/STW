rules_version = '2';

// Paste this into Firebase console -> Firestore Database -> Rules, then Publish.
// Phase 1-2: sign-in, per-user project access, cloud sync. Roles are already respected for edits.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function userPath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function isAdmin() { return signedIn() && exists(userPath()) && get(userPath()).data.role == 'admin'; }
    function isExec()  { return signedIn() && exists(userPath()) && get(userPath()).data.role == 'executive'; }
    function myRole()  { return resource.data.members.get(request.auth.uid, ''); }

    // A user document is created by the user on first sign-in, always as a plain "member".
    // Only an admin can change roles (first admin: set role to "admin" by hand in the console).
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'member'
                    && request.resource.data.keys().hasOnly(['email', 'role', 'createdAt']);
      allow update, delete: if isAdmin();
    }

    // One document per project. memberIds / members decide who can see and edit it.
    match /projects/{pid} {
      allow read: if signedIn() && (request.auth.uid in resource.data.memberIds || isAdmin() || isExec());

      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.memberIds == [request.auth.uid]
                    && request.resource.data.members[request.auth.uid] == 'pm'
                    && request.resource.data.json is string
                    && request.resource.data.json.size() < 900000;

      allow update: if signedIn()
                    && request.resource.data.json.size() < 900000
                    && (
                      isAdmin()
                      || myRole() == 'pm'
                      || (myRole() in ['lead', 'contrib']
                          && request.resource.data.members == resource.data.members
                          && request.resource.data.memberIds == resource.data.memberIds
                          && request.resource.data.ownerId == resource.data.ownerId)
                    );

      allow delete: if signedIn() && (isAdmin() || myRole() == 'pm');
    }
  }
}
